APP_NAME=AlgoMate Agent Service
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
ALGOMATE_HTTP_PORT=8080
MAX_HISTORY_MESSAGES=20
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_SOFT_LIMIT_TOKENS=24576
CONTEXT_HARD_LIMIT_TOKENS=28672
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_RECENT_MESSAGES=8
CONTEXT_RECENT_TOKEN_BUDGET=6144
CONTEXT_COMPRESS_EVERY_REQUEST=false
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
llm-timeout=60
llm-max-disconnect-retries=5
llm-retry-base-delay-seconds=0.5
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=replace_with_a_strong_redis_password
MODEL_CONFIG_ENCRYPTION_KEY=replace_with_at_least_24_random_characters
MODEL_CONFIG_MAX_TTL_SECONDS=2592000
MODEL_BASE_URL_ALLOWED_HOSTS=
embedding-provider=voyage
embedding-base-url=https://api.voyageai.com/v1
embedding-general-model=voyage-4
embedding-code-model=voyage-code-4
embedding-api-key=
embedding-dimension=1024
embedding-rate-limit-tpm=10000
embedding-rate-limit-rpm=3
embedding-batch-token-budget=7500
voyage-rerank-model=rerank-2.5
milvus-uri=rag-data/vector/algomate-milvus.db
milvus-concept-collection=algomate_algorithm_concepts_voyage4_v1
milvus-problem-collection=algomate_problem_bank_voyage4_v1
milvus-code-collection=algomate_code_cases_voyage_code4_v1
